# =============================================================================
# Open Local AI Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and review settings before starting services.
#   cp .env.example .env
#
# All variables have sensible defaults. Uncomment and change only what you need.
# Secrets MUST be changed before exposing services beyond localhost.
# =============================================================================

# ----- Timezone -----
# TZ=Asia/Kolkata

# ----- Ollama -----
# OLLAMA_PORT=11434
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MEMORY_LIMIT=8G
# OLLAMA_MEMORY_RESERVE=2G
# NVIDIA_VISIBLE_DEVICES=0
# NVIDIA_DEVICE_COUNT=0

# ----- Open WebUI -----
# OPEN_WEBUI_PORT=3000

# ----- SearXNG -----
# SEARXNG_PORT=8080

# ----- Perplexica -----
# PERPLEXICA_PORT=3001

# ----- Paperless-ngx -----
# PAPERLESS_PORT=8000
# PAPERLESS_ADMIN_USER=admin
# PAPERLESS_ADMIN_PASSWORD=change-me-now
# PAPERLESS_SECRET_KEY=change-this-to-a-long-random-secret
# POSTGRES_PASSWORD=change-me-now

# ----- Blinko -----
# BLINKO_PORT=1111

# ----- Karakeep -----
# KARAKEEP_PORT=3002

# ----- Pulse (Docker monitoring) -----
# PULSE_PORT=7655

# ----- Open Notebook -----
# OPEN_NOTEBOOK_PORT=8502

# ----- Code Server -----
# CODE_SERVER_PORT=8443
# CODE_SERVER_PASSWORD=change-this-password
# WORKSPACE_DIR=./workspace

# ----- TabbyML (self-hosted Copilot) -----
# TABBY_PORT=8080
# TABBY_MEMORY_LIMIT=8G

# ----- n8n (workflow automation) -----
# N8N_PORT=5678

# ----- Khoj (AI assistant with memory) -----
# KHOJ_PORT=42110
# KHOJ_ADMIN_EMAIL=admin@example.com
# KHOJ_ADMIN_PASSWORD=change-me-now

# ----- LibreChat (multi-model chat) -----
# LIBRECHAT_PORT=3080
# LIBRECHAT_CREDS_KEY=change-this-to-a-random-32-char-string
# LIBRECHAT_CREDS_IV=change-this-to-a-random-16-char-string
# LIBRECHAT_JWT_SECRET=change-this-to-a-random-secret
# LIBRECHAT_JWT_REFRESH_SECRET=change-this-to-another-random-secret
